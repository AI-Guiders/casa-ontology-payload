    { "lattice_id": "alphabet-en", "legacy_id": "L0_grapheme_latn", "semantic_id": "memory.grapheme.latn", "z_level": 0, "nca_profile": "sss" },
    { "lattice_id": "syllables-ru", "legacy_id": "L1_syllable", "semantic_id": "memory.syllable", "z_level": 1, "nca_profile": "sss" },
