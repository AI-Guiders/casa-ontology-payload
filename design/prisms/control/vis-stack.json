      "role": ["bottom_up", "novelty", "frame_salience"]
    },
    {
      "lattice_id": "control-vis-spotlight",
      "legacy_id": "lattice_vis_dan",
      "z_ctrl": 1,
      "concept_prefix": "vis.spot.",
