    { "id": "port_P12", "from": "prism_visual", "to": "control-vis-salience", "kind": "vis_surprise", "channels": ["port.vis_surprise.*"] },
    { "id": "port_P13", "from": "control-vis-gate", "to": "control-salience", "kind": "modality_bias", "note": "cross-prism: to prism_control_exec SN" }
  ],
  "ltm_path_template": "ltm/control/vis/{lattice_id}.ltm"
