{
  "schema_version": 1,
  "subsystem": "first_signal_math",
  "title": "Первая сигнальность — логико-математический стек F0…F2",
  "doc": "design/f0-math-logical-layer-v0.md",
  "parent_cylinder": "cyl_memory",
  "sibling_subsystems": {
    "sss": "design/sss-lattice-stack.v0.json",
    "vis_roadmap": "design/experiment-l-concrete-to-abstract-v0.md"
  },
  "axes": {
    "x": "cell within lattice",
    "y": "cell within lattice",
    "f_level": "логический уровень (схема → экземпляр → величина)",
    "z_note": "F-стек ортогонален z ССС (L0..L3); общий cyl_memory, разные subsystem_id",
    "T_wake": "compose, count, compare",
    "T_sleep": "consolidate schema → стабильные M: / hub edges"
  },
  "concept_namespaces": {
    "math": "схема, число, операция (modal-agnostic)",
    "math.unit": "тип счётной единицы (cow, stick, apple)",
    "math.card": "мощность / количество",
    "math.op": "операция над однородными единицами",
    "lang": "имя на второй СС — мост, не дубликат логики",
    "vis": "якорь картинки — Exp L, не hot path v0"
  },
  "lattices": [
    {
      "id": "F0_schema",
      "f_level": 0,
      "size": { "width": 32, "height": 32 },
      "token_prefix": ["M:", "M:sym:"],
      "role": ["pure_symbol", "stick_count", "operators"],
      "lab": ["M:sym:one", "M:sym:two", "M:op:add", "M:op:eq"],
      "status": "v0_text",
      "curriculum": "experiment-l L0"
    },
    {
      "id": "F1_compose",
      "f_level": 1,
      "size": { "width": 32, "height": 32 },
      "token_prefix": ["M:inst:", "M:unit:"],
      "role": ["instance_slots", "homogeneous_merge", "working_memory"],
      "lab": ["M:inst:cow@a", "M:inst:cow@b", "M:unit:cow"],
      "status": "design",
      "note": "«одна корова + ещё одна корова» — два слота одного M:unit:cow"
    },
    {
      "id": "F2_quantity",
      "f_level": 2,
      "size": { "width": 32, "height": 32 },
      "token_prefix": ["M:qty:"],
      "role": ["bound_quantity", "cardinality_plus_unit"],
      "lab": ["M:qty:2×cow", "M:qty:3×stick"],
      "status": "design",
      "note": "результат compose; не путать с lang.word.две"
    }
  ],
  "f_bridges": [
    {
      "id": "f_bridge_F0_F1",
      "from": "F0_schema",
      "to": "F1_compose",
      "kind": "instantiate",
      "example": "M:sym:one → один слот M:inst:*"
    },
    {
      "id": "f_bridge_F1_F2",
      "from": "F1_compose",
      "to": "F2_quantity",
      "kind": "aggregate",
      "when": "same M:unit:*",
      "example": "cow@a + cow@b → M:qty:2×cow"
    },
    {
      "id": "f_bridge_F2_L2",
      "from": "F2_quantity",
      "to": "L2_word",
      "kind": "name",
      "via": "concept_hub",
      "note": "«2 коровы» — SN/CEN + lang, не прямой write в L2 без sleep"
    },
    {
      "id": "f_bridge_L2_F1",
      "from": "L2_word",
      "to": "F1_compose",
      "kind": "ground_word",
      "example": "lang.word.cow → M:unit:cow"
    },
    {
      "id": "f_bridge_F2_vis",
      "from": "F2_quantity",
      "to": "F0_vis",
      "kind": "ground_image",
      "status": "roadmap",
      "doc": "experiment-l L2–L4"
    }
  ],
  "hub": {
    "id": "concept_hub_math_lang",
    "edges": [
      "E:math.unit.cow|lang.word.cow",
      "E:math.card.two|lang.word.two",
      "E:M:qty:2×cow|lang.word.коровы"
    ],
    "rule": "логика на F*; слова на L*; связь через E:, не слияние решёток"
  },
  "routing": {
    "sn": ["active_subsystem", "active_f_lattice", "modality_gate"],
    "cen": ["compose_instances", "count", "compare", "name_quantity"],
    "homogeneity_rule": "M:op:add только при одинаковом M:unit:*"
  },
  "text_only_v0": {
    "enabled": true,
    "note": "Можно начать без vis: палочки как M:sym:*, корова как L2 + M:unit:cow"
  },
  "nca": {
    "per_lattice": false,
    "default": "shared DMN/windowed train on hub union when implemented",
    "doc": "nca-train-defaults.v0.json"
  }
}
