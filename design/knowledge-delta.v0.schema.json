{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AI-Guiders/casa-ontology-payload/knowledge-delta.v0.schema.json",
  "title": "CASA Knowledge Delta v0",
  "description": "Exchange packet between agents: bundle/graph delta + digest + dependencies.",
  "type": "object",
  "required": ["schema_version", "type", "source_agent_id", "digest"],
  "properties": {
    "schema_version": { "const": 1 },
    "type": {
      "type": "string",
      "enum": ["knowledge_delta", "bundle_full", "digest_only", "checkpoint_hard"]
    },
    "source_agent_id": { "type": "string" },
    "target_cluster": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" },
    "bundle": {
      "type": "object",
      "description": "Inline bundle or reference.",
      "properties": {
        "path": { "type": "string" },
        "inline": { "type": "object" },
        "action": { "type": "string", "enum": ["add", "replace", "patch"] }
      }
    },
    "graph_patch": {
      "type": "object",
      "properties": {
        "nodes_add": { "type": "array", "items": { "type": "object" } },
        "edges_add": { "type": "array", "items": { "type": "object" } },
        "edges_remove": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["src", "relation", "dst"],
            "properties": {
              "src": { "type": "string" },
              "relation": { "type": "string" },
              "dst": { "type": "string" }
            }
          }
        }
      }
    },
    "digest": {
      "type": "object",
      "required": ["summary"],
      "properties": {
        "summary": { "type": "string" },
        "added_concept_ids": { "type": "array", "items": { "type": "string" } },
        "removed_concept_ids": { "type": "array", "items": { "type": "string" } },
        "added_edges": {
          "type": "array",
          "items": { "type": "string", "description": "E:src|rel|dst token form" }
        },
        "modules_activated": {
          "type": "array",
          "items": { "type": "string", "description": "module_id from kb-modules manifest" }
        },
        "tier": { "type": "string", "enum": ["easy", "hard"] }
      }
    },
    "requires": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Bundle filenames the receiver must already have (graph closure)."
    },
    "provides": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Bundles included in this delta for receiver import."
    },
    "checkpoint_hard": {
      "type": "string",
      "description": "Optional path to model_hard.pt if receiver should finetune/import weights."
    },
    "epistemic": {
      "type": "object",
      "properties": {
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "source_doc_paths": { "type": "array", "items": { "type": "string" } },
        "conflicts_with": {
          "type": "array",
          "items": { "type": "string" },
          "description": "concept_id or bundle@section that must NOT be merged blindly (L0)."
        }
      }
    }
  }
}
