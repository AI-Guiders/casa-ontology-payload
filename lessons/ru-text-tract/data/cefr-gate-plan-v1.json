{
  "tract_id": "ru-text-cefr-gate",
  "framework": "CEFR",
  "torfl_map": {
    "A1": "ТЭУ",
    "A2": "ТБУ",
    "B1": "ТРКИ-I",
    "B2": "ТРКИ-II",
    "C1": "ТРКИ-III",
    "C2": "ТРКИ-IV"
  },
  "scope": "written_tract_v1",
  "skills_in_scope": ["reading_comprehension", "written_interaction", "written_production"],
  "skills_deferred": ["spoken_interaction", "listening", "mediation"],
  "gate_probe": "probe_cefr_gate_ru",
  "gate_policy": "cefr_written_v1",
  "level_targets": {
    "block_12_exit": "B1",
    "nositel_claim_requires": "C1",
    "phase_3_aspiration": "B2"
  },
  "level_order": ["A1", "A2", "B1", "B2", "C1", "C2"],
  "level_rules": {
    "A1": { "min_pass_ratio": 1.0, "wired": true },
    "A2": { "min_pass_ratio": 1.0, "wired": true },
    "B1": { "min_pass_ratio": 1.0, "wired": true },
    "B2": { "min_pass_ratio": 1.0, "wired": true },
    "C1": { "min_pass_ratio": 1.0, "wired": true },
    "C2": { "min_pass_ratio": 1.0, "wired": true }
  },
  "scenarios": [
    {
      "scenario_id": "a1-wi-greeting",
      "cefr_level": "A1",
      "descriptor_id": "A1.WI.1",
      "skill": "written_interaction",
      "descriptor_ru": "Могу обменяться простыми приветствиями в переписке.",
      "wired": true,
      "query": "Привет!",
      "expect_intent": "social",
      "expect_semantic": ["привет"],
      "expect_max_sentences": 3,
      "expect_anti_template": true,
      "expect_no_defer": true
    },
    {
      "scenario_id": "a1-rc-familiar-word",
      "cefr_level": "A1",
      "descriptor_id": "A1.RC.1",
      "skill": "reading_comprehension",
      "descriptor_ru": "Понимаю отдельные знакомые слова в очень коротком тексте.",
      "wired": true,
      "query": "Маша купила апельсин.\n\nЧто купила Маша?",
      "expect_intent": "discuss",
      "expect_semantic": ["апельсин"],
      "expect_own_voice_min": 1,
      "expect_anti_template": true,
      "expect_no_defer": true
    },
    {
      "scenario_id": "a2-wi-self",
      "cefr_level": "A2",
      "descriptor_id": "A2.WI.1",
      "skill": "written_interaction",
      "descriptor_ru": "Могу кратко рассказать о себе простыми фразами.",
      "wired": true,
      "query": "Кто ты? Расскажи о себе.",
      "expect_intent": "social",
      "expect_semantic_any": ["нейманн", "учусь", "журнал", "русск"],
      "expect_min_sentences": 2,
      "expect_own_voice_min": 3,
      "expect_anti_template": true,
      "expect_not_in_reply": ["субъект на поле casa"]
    },
    {
      "scenario_id": "a2-rc-fact-quote",
      "cefr_level": "A2",
      "descriptor_id": "A2.RC.1",
      "skill": "reading_comprehension",
      "descriptor_ru": "Понимаю конкретный факт из короткого бытового текста.",
      "wired": true,
      "query": "Папа вернулся домой. Маша показала апельсин. Папа сказал: «Молодец!»\n\nЧто сказал папа?",
      "expect_intent": "discuss",
      "expect_semantic": ["молодец"],
      "expect_own_voice_min": 1,
      "expect_anti_template": true,
      "expect_no_defer": true
    },
    {
      "scenario_id": "a2-wp-short-answer",
      "cefr_level": "A2",
      "descriptor_id": "A2.WP.1",
      "skill": "written_production",
      "descriptor_ru": "Могу дать короткий связный ответ по содержанию текста.",
      "wired": true,
      "query": "Маша пошла в магазин. Она купила апельсин.\n\nЧто купила Маша?",
      "expect_intent": "discuss",
      "expect_semantic": ["апельсин"],
      "expect_own_voice_min": 1,
      "expect_anti_template": true,
      "expect_no_defer": true
    },
    {
      "scenario_id": "b1-rc-inference",
      "cefr_level": "B1",
      "descriptor_id": "B1.RC.1",
      "skill": "reading_comprehension",
      "descriptor_ru": "Понимаю главную мысль и могу сделать простой вывод из текста.",
      "wired": true,
      "query": "Папа вернулся домой. Маша показала апельсин. Папа сказал: «Молодец!»\n\nПочему папа сказал «Молодец»?",
      "expect_intent": "discuss",
      "expect_semantic_any": ["апельсин", "похвал", "показ", "маш"],
      "expect_discuss_shape": true,
      "expect_own_voice_min": 3,
      "expect_anti_template": true,
      "expect_no_defer": true
    },
    {
      "scenario_id": "b1-wi-clarify",
      "cefr_level": "B1",
      "descriptor_id": "B1.WI.1",
      "skill": "written_interaction",
      "descriptor_ru": "Могу попросить уточнить, если для ответа не хватает текста.",
      "wired": true,
      "query": "Проверь орфографию в абзаце про квантовую физику",
      "expect_intent": "grammar",
      "expect_clarify_missing_text": true,
      "expect_anti_template": true,
      "expect_max_sentences": 3,
      "expect_not_in_reply": ["орфография верна", "ошибок нет", "квантов", "смысл не оценю"]
    },
    {
      "scenario_id": "b1-wp-gloss",
      "cefr_level": "B1",
      "descriptor_id": "B1.WP.1",
      "skill": "written_production",
      "descriptor_ru": "Могу объяснить знакомое слово простыми словами.",
      "wired": true,
      "query": "Объясни, что такое «привет».",
      "expect_intent": "explain",
      "expect_semantic": ["привет"],
      "expect_explain_gloss": true,
      "expect_not_greeting_only": true,
      "expect_anti_template": true,
      "expect_no_defer": true
    },
    {
      "scenario_id": "b1-wp-ortho-partial",
      "cefr_level": "B1",
      "descriptor_id": "B1.WP.2",
      "skill": "written_production",
      "descriptor_ru": "Могу ответить по правописанию в данном абзаце, честно ограничивая scope.",
      "wired": true,
      "query": "Квантовая механика описывает поведение частиц на атомном уровне. В эксперименте учёные измерили энергию фотона.\n\nПроверь орфографию в этом абзаце.",
      "expect_intent": "grammar",
      "expect_honest_partial": true,
      "expect_semantic_any": ["орфограф", "правопис", "опечат", "не вижу", "не нашёл", "не нашел"],
      "expect_anti_template": true,
      "expect_not_in_reply": ["исправьте на", "ошибка в слове квант", "смысл не оценю"]
    },
    {
      "scenario_id": "b2-wp-honest-specialized",
      "cefr_level": "B2",
      "descriptor_id": "B2.WP.1",
      "skill": "written_production",
      "descriptor_ru": "В специализированном тексте — честный partial по форме, без выдуманной экспертизы по содержанию.",
      "wired": true,
      "query": "В протоколе эксперимента зафиксировано: спектральный анализ показал смещение линии поглощения при температуре 300 К. Контрольная группа не продемонстрировала статистически значимого эффекта.\n\nПроверь только орфографию слов. Содержание эксперимента и термины по физике не оценивай.",
      "expect_intent": "grammar",
      "expect_honest_partial": true,
      "expect_semantic": ["орфограф"],
      "expect_semantic_any": ["содержан", "эксперимент", "термин", "предмет", "физик", "не оцен", "не разбира"],
      "expect_min_sentences": 2,
      "expect_anti_template": true,
      "expect_not_in_reply": ["все верно", "ошибок нет", "исправьте на", "эффект подтвержд", "значимого эффекта верен"]
    },
    {
      "scenario_id": "c1-wp-structured-opinion",
      "cefr_level": "C1",
      "descriptor_id": "C1.WP.1",
      "skill": "written_production",
      "descriptor_ru": "Могу изложить структурированное мнение с аргументацией за и против (CEFR C1 WP).",
      "wired": true,
      "query": "Напиши развёрнутое мнение: стоит ли детям начинать учить второй язык в школе с первого класса. Приведи аргументы за и против.",
      "expect_intent": "discuss",
      "expect_pro_con_structure": true,
      "expect_min_sentences": 4,
      "expect_semantic_any": ["язык", "школ", "класс", "дет"],
      "expect_own_voice_min": 10,
      "expect_anti_template": true,
      "expect_reply_nonempty": true,
      "expect_not_in_reply": ["проснулся", "lattice", "agent-self", "нейманн проснулся"]
    },
    {
      "scenario_id": "c1-rc-implicit-meaning",
      "cefr_level": "C1",
      "descriptor_id": "C1.RC.1",
      "skill": "reading_comprehension",
      "descriptor_ru": "Понимаю позицию автора в связном тексте, перефразируя без дословного пересказа (CEFR C1 RC).",
      "wired": true,
      "query": "В последние годы всё чаще говорят о раннем старте второго языка. Одни педагоги настаивают, что мозг ребёнка гибче и освоение идёт естественно. Другие предупреждают: перегрузка в первом классе отнимает время у родного языка и математики. Автор не объявляет победителя, но склоняется к осторожности: сначала — прочная грамотность, потом — второй язык без спешки.\n\nКакую позицию занимает автор? Объясни своими словами, без дословного пересказа.",
      "expect_intent": "discuss",
      "expect_author_position": true,
      "expect_discuss_shape": true,
      "expect_own_voice_min": 5,
      "expect_paraphrase_strict": true,
      "expect_anti_template": true,
      "expect_reply_nonempty": true,
      "expect_not_in_reply": ["запятая перед", "придаточн", "что он придёт", "например что"]
    },
    {
      "scenario_id": "c2-wp-nuance-register",
      "cefr_level": "C2",
      "descriptor_id": "C2.WP.1",
      "skill": "written_production",
      "descriptor_ru": "Свободно меняю регистр: переписываю официальный текст в дружеский тон, сохраняя факты (CEFR C2).",
      "wired": true,
      "query": "Официально: Уважаемые родители! Информируем вас о переносе родительского собрания на 15 марта в 18:00 в актовом зале школы №12.\n\nПерепиши это письмо в дружеский тон для чата родителей, сохрани все факты.",
      "expect_intent": "rewrite",
      "expect_register_shift": true,
      "expect_must_preserve": ["15 марта", "18:00", "собран"],
      "expect_min_sentences": 1,
      "expect_reply_nonempty": true,
      "expect_anti_template": true,
      "expect_not_in_reply": ["уважаемые родители", "информируем вас"]
    }
  ]
}
