{
  "schema_version": 1,
  "bundle_id": "kb-input-modality-vk-v1",
  "title": "Input modality: full keyboard device + layouts",
  "claims": [
    {
      "concept_id": "input.device.keyboard",
      "claim": "Keyboard is a layout-neutral input device: physical keys, zones, modifiers, and decode layouts."
    },
    {
      "concept_id": "input.modality.physical_key",
      "claim": "PhysicalKeyEvent is layout-neutral: key_id follows W3C KeyboardEvent.code (KeyA, Slash), not OS Unicode."
    },
    {
      "concept_id": "input.modality.layout",
      "claim": "Keyboard layout is a decode table: same physical keys → different graphemes (qwerty_us vs jcuken_ru)."
    },
    {
      "concept_id": "input.modality.base_layer",
      "claim": "Base (unshifted) layout layer: default keyboard register — lowercase letters when no Shift/Caps latch."
    },
    {
      "concept_id": "input.modality.shift_layer",
      "claim": "Shift layer is a second decode table (layout.*.shift) selected while Shift modifier is held or Caps latched."
    },
    {
      "concept_id": "input.modality.modifier",
      "claim": "Modifier keys (Shift, Control, Alt, Meta, CapsLock) change decode context; they do not emit graphemes."
    },
    {
      "concept_id": "input.modality.action_key",
      "claim": "Action keys (Enter, Backspace, arrows, Fn) emit action.* concepts, not grapheme strings."
    },
    {
      "concept_id": "input.modality.layout_parity",
      "claim": "Layout parity runs dual decode branches and picks winner by segment (prose RU vs command EN)."
    },
    {
      "concept_id": "layout.qwerty_us",
      "claim": "US QWERTY layout: physical keys decode to Latin graphemes on L0_grapheme."
    },
    {
      "concept_id": "layout.jcuken_ru",
      "claim": "Russian JCUKEN layout: same physical keys decode to Cyrillic graphemes on L0_grapheme."
    },
    {
      "concept_id": "grapheme.latn",
      "claim": "Latin script namespace on L0_grapheme (grapheme.latn.*)."
    },
    {
      "concept_id": "grapheme.cyrl",
      "claim": "Cyrillic script namespace on L0_grapheme (grapheme.cyrl.*)."
    },
    {
      "concept_id": "modifier.shift",
      "claim": "Shift modifier selects shift decode layer (uppercase / symbols)."
    },
    {
      "concept_id": "modifier.control",
      "claim": "Control modifier — chord context (v1 listen only, no chord decode yet)."
    },
    {
      "concept_id": "modifier.alt",
      "claim": "Alt modifier — chord context (v1 listen only)."
    },
    {
      "concept_id": "modifier.meta",
      "claim": "Meta/OS modifier — chord context (v1 listen only)."
    },
    {
      "concept_id": "modifier.caps_lock",
      "claim": "CapsLock toggles caps latch: letters decode from shift layer until toggled off; surface effect = ALL CAPS (proc.word.upper)."
    },
    {
      "concept_id": "input.modality.caps_latch",
      "claim": "Caps latch state: persistent shift-layer decode for letters (like Caps Lock on)."
    },
    {
      "concept_id": "ortho.display.all_caps",
      "claim": "ALL CAPS display = proc.word.upper (fold proc.grapheme.capitalize over word); same surface as Caps Lock typing."
    },
    {
      "concept_id": "proc.grapheme.capitalize",
      "claim": "Ortho atom: one grapheme lower → upper (м→М, a→A). Shift layer surface_effect."
    },
    {
      "concept_id": "proc.word.upper",
      "claim": "Ortho fold: Capitalize every letter in word (ALL CAPS). Caps Lock surface_effect."
    },
    {
      "concept_id": "proc.word.sentence_case",
      "claim": "Ortho: Capitalize first letter only (sentence/title case); complements Shift (manual cap)."
    },
    {
      "concept_id": "ortho.display.lowercase_register",
      "claim": "Lowercase register from keyboard = base layer decode (no modifiers). Not the same as emergent proc.grapheme.lower."
    },
    {
      "concept_id": "proc.grapheme.lower",
      "claim": "Emergent ortho inverse of Capitalize (М→м) after surprise — display correction, not default keyboard path."
    },
    {
      "concept_id": "action.enter",
      "claim": "Enter key — line break / submit action."
    },
    {
      "concept_id": "action.backspace",
      "claim": "Backspace key — delete left action."
    },
    {
      "concept_id": "zone.alphanumeric",
      "claim": "Alphanumeric typing zone (letters, digits, punctuation, space)."
    },
    {
      "concept_id": "zone.modifier_row",
      "claim": "Modifier row zone (Shift, Ctrl, Alt, Meta, CapsLock)."
    },
    {
      "concept_id": "zone.editing",
      "claim": "Editing zone (Enter, Backspace, Tab, Delete)."
    },
    {
      "concept_id": "zone.navigation",
      "claim": "Navigation zone (arrows, Home, End, PgUp/PgDn)."
    },
    {
      "concept_id": "zone.function_row",
      "claim": "Function row (F1–F12)."
    },
    {
      "concept_id": "vk.physical",
      "claim": "vk.physical.* concepts name physical keys; compose edges link to grapheme.* or action.*."
    },
    {
      "concept_id": "memory.core_ltm.vk",
      "claim": "VK keyboard ships as immutable core ltm (listen, no NCA train); boot → field RAM."
    },
    {
      "concept_id": "memory.train.lexicon_nca",
      "claim": "Lexicon L2 shards train via sleep NCA (nca_stale_shards / agent_autonomous_tick) — separate from VK listen."
    }
  ],
  "graph": {
