    {
      "concept_id": null,
      "text": "Реализация-лаборатория субстрата: Financial/software/open/nca-lab/ в репозитории DTS (Growing NCA, PyTorch train → C# inference).",
      "doc_path": "work/projects/door-to-singularity/ca-substrate-agent/casa-goals-and-roadmap-v1.md",
