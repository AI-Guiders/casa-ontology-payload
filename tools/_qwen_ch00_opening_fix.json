[
  {"id": "b000", "t0": 0.0, "t1": 2.0, "frame_t": 1.0, "note": "«Чего боятся колготки?»"},
  {"id": "b001", "t0": 2.0, "t1": 3.0, "frame_t": 2.5, "note": "пауза / смена титра"},
  {"id": "b002", "t0": 3.0, "t1": 5.0, "frame_t": 4.0, "note": "Автор: Анастасия Безлюдная"},
  {"id": "b003", "t0": 5.0, "t1": 7.0, "frame_t": 6.0, "note": "Иллюстратор: Марат Симаков"},
  {"id": "b004", "t0": 7.0, "t1": 15.5, "frame_t": 11.0, "note": "«В большом комоде, в верхнем ящике, жили Колготки»"},
  {"id": "b005", "t0": 15.5, "t1": 22.5, "frame_t": 18.5, "note": "«Колготки были новые — синие, с маленькими белыми корабликами по бокам»"},
  {"id": "b006", "t0": 22.5, "t1": 28.0, "frame_t": 25.0, "note": "«Колготки эти были трусишки. Они боялись всего на свете!»"},
  {"id": "b007", "t0": 28.0, "t1": 30.5, "frame_t": 29.0, "note": "«Колготки были тёплые»"},
  {"id": "b008", "t0": 30.5, "t1": 37.0, "frame_t": 33.5, "note": "«Поэтому боялись, что в них заползёт удав и устроит себе логово на зиму!»"},
  {"id": "b009", "t0": 37.0, "t1": 39.5, "frame_t": 38.0, "note": "«Страшно!» (удав)"},
  {"id": "b010", "t0": 39.5, "t1": 43.0, "frame_t": 41.0, "note": "«Колготки умели тянуться»"},
  {"id": "b011", "t0": 43.0, "t1": 47.0, "frame_t": 44.5, "note": "«Поэтому боялись, что их наденет огромный динозавр»"},
  {"id": "b012", "t0": 47.0, "t1": 50.5, "frame_t": 48.5, "note": "«и продырявит своими острыми когтищами!»"},
  {"id": "b013", "t0": 50.5, "t1": 53.0, "frame_t": 51.5, "note": "«Страшно!» (динозавр)"},
  {"id": "b014", "t0": 53.0, "t1": 57.0, "frame_t": 54.5, "note": "«У Колготок были две длинные штанины»"},
  {"id": "b015", "t0": 57.0, "t1": 64.5, "frame_t": 60.5, "note": "«Поэтому Колготки боялись, что их наденут на голову, и они превратятся в заячьи уши!»"},
  {"id": "b016", "t0": 64.5, "t1": 67.5, "frame_t": 65.5, "note": "«Страшно!» (заячьи уши)"},
  {"id": "b017", "t0": 67.5, "t1": 70.0, "frame_t": 68.5, "note": "«Колготки были чистые»"},
  {"id": "b018", "t0": 70.0, "t1": 76.0, "frame_t": 72.5, "note": "«Поэтому боялись, что испачкаются и станут похожи на дождевых червяков!»"},
  {"id": "b019", "t0": 76.0, "t1": 78.5, "frame_t": 77.0, "note": "«Страшно!» (червяки)"},
  {"id": "b020", "t0": 78.5, "t1": 83.5, "frame_t": 81.0, "note": "«А ещё Колготки боялись, что их съест моль!»"},
  {"id": "b021", "t0": 83.5, "t1": 88.0, "frame_t": 85.5, "note": "«Наделает бутербродов с Колготками и съест!»"},
  {"id": "b022", "t0": 88.0, "t1": 91.5, "frame_t": 89.5, "note": "«Страшно!» (моль)"},
  {"id": "b023", "t0": 91.5, "t1": 95.0, "frame_t": 93.0, "note": "«Но вот однажды...»"},
  {"id": "b024", "t0": 95.0, "t1": 98.5, "frame_t": 96.5, "note": "«...ящик открыл мальчик Ванечка»"},
  {"id": "b025", "t0": 98.5, "t1": 103.0, "frame_t": 100.5, "note": "«У него не было когтей, зато были две тёплые ножки»"},
  {"id": "b026", "t0": 103.0, "t1": 108.0, "frame_t": 105.0, "note": "«Ванечка надел Колготки на ножки и отправился на прогулку»"},
  {"id": "b027", "t0": 108.0, "t1": 111.5, "frame_t": 109.5, "note": "«Они залезали на высокую горку»"},
  {"id": "b028", "t0": 111.5, "t1": 115.0, "frame_t": 113.0, "note": "«и смело съезжали с неё вниз!»"},
  {"id": "b029", "t0": 115.0, "t1": 120.0, "frame_t": 117.5, "note": "«Они взлетали на качелях до самого неба!»"},
  {"id": "b030", "t0": 120.0, "t1": 124.0, "frame_t": 121.5, "note": "«И даже бесстрашно шагали по грязным лужам!»"},
  {"id": "b031", "t0": 124.0, "t1": 132.0, "frame_t": 127.0, "note": "«— Вот это да... Вокруг так интересно и совсем не страшно!»"},
  {"id": "b032", "t0": 132.0, "t1": 135.0, "frame_t": 133.0, "note": "«После прогулки Колготки испачкались»"},
  {"id": "b033", "t0": 135.0, "t1": 139.0, "frame_t": 136.5, "note": "«и Мама положила их в стиральную машину»"},
  {"id": "b034", "t0": 139.0, "t1": 144.5, "frame_t": 141.5, "note": "«Мама нажала на кнопку, и Колготки завертелись»"},
  {"id": "b035", "t0": 144.5, "t1": 148.5, "frame_t": 146.5, "note": "«— Мы рыбы! — решили Колготки»"},
  {"id": "b036", "t0": 148.5, "t1": 152.0, "frame_t": 150.0, "note": "«и стали играть в догонялки с другими вещами»"},
  {"id": "b037", "t0": 152.0, "t1": 158.0, "frame_t": 154.5, "note": "«Когда стирка закончилась, мама достала Колготки и повесила сушиться на верёвку»"},
  {"id": "b038", "t0": 158.0, "t1": 165.0, "frame_t": 161.0, "note": "«— Мы птицы! — обрадовались Колготки и весело замахахи синими крыльями»"},
  {"id": "b039", "t0": 165.0, "t1": 171.0, "frame_t": 167.5, "note": "«Вечером мама сложила Колготки на стульчик рядом с Ваниной кроваткой»"},
  {"id": "b040", "t0": 171.0, "t1": 174.0, "frame_t": 172.0, "note": "«— Поскорее бы наступило завтра»"},
  {"id": "b041", "t0": 174.0, "t1": 181.5, "frame_t": 177.0, "note": "«У нас будут новые, страшно интересные приключения!»"},
  {"id": "b042", "t0": 181.5, "t1": 188.0, "frame_t": 184.0, "note": "«Конец» — финальный экран"},
  {"id": "b043", "t0": 188.0, "t1": 200.5, "frame_t": 192.0, "note": "титры / credits"}
]
